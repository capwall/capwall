{
  "name": "@capwall/cli",
  "version": "0.1.0",
  "description": "capwall command-line interface: observe | enforce | run | diff | gen-policy | explain.",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capwall/capwall.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/capwall/capwall#readme",
  "bugs": "https://github.com/capwall/capwall/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "capwall": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "prepack": "node ../../scripts/assert-pnpm-pack.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@capwall/core": "workspace:*",
    "@capwall/policy-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
