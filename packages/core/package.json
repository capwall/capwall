{
  "name": "@capwall/core",
  "version": "0.1.1",
  "description": "capwall interception engine + policy evaluator: per-package runtime capability enforcement for Node.js.",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capwall/capwall.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/capwall/capwall#readme",
  "bugs": "https://github.com/capwall/capwall/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "prepack": "node ../../scripts/assert-pnpm-pack.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@capwall/policy-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
