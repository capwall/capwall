{
  "name": "@capwall/core",
  "version": "0.1.0",
  "description": "capwall interception engine + policy evaluator: per-package runtime capability enforcement for Node.js.",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamzujkowski/capwall.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/williamzujkowski/capwall#readme",
  "bugs": "https://github.com/williamzujkowski/capwall/issues",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    }
  },
  "files": ["dist", "src"],
  "engines": { "node": ">=22.15.0" },
  "scripts": {
    "prepack": "node ../../scripts/assert-pnpm-pack.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@capwall/policy-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
