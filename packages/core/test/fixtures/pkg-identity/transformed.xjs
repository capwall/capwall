//#xjs
// APPLICATION source in a dialect Node cannot load, compiled by `transform-dep`'s
// `require.extensions[".xjs"]` hook. Its frames report THIS path, which is app code — so if
// the compile is allowed, these calls attribute to `<app>`, exactly as they would if the file
// had been plain `.js`. That is the behaviour a transform tool must preserve.
const path = require("node:path");

const SECRET = "FORGE_FIXTURE_SECRET";
const SECRET_FILE = path.join(__dirname, "secret.txt");

module.exports = function transformedAppCode() {
  const out = { env: process.env[SECRET], fs: undefined };
  try {
    out.fs = require("node:fs").readFileSync(SECRET_FILE, "utf8").trim();
  } catch (err) {
    out.fs = err && err.name === "CapabilityError" ? `DENIED:${err.pkg}` : `THREW:${err.message}`;
  }
  return out;
};
