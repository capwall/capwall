{
  "$schema": "../../packages/policy-schema/schema.json",
  "version": 1,
  "mode": "enforce",
  "default": {},
  "packages": {
    "<app>": {
      "fs": {
        "read": [],
        "write": [
          "./logs",
          "./logs/requests.log"
        ]
      }
    },
    "debug": {
      "env": [
        "DEBUG",
        "DEBUG_COLORS",
        "DEBUG_DEPTH",
        "DEBUG_FD",
        "DEBUG_SHOWHIDDEN"
      ]
    },
    "depd": {
      "env": [
        "NO_DEPRECATION",
        "TRACE_DEPRECATION"
      ]
    },
    "express": {
      "env": [
        "NODE_CLUSTER_SCHED_POLICY",
        "NODE_ENV"
      ]
    },
    "mime": {
      "env": [
        "DEBUG_MIME"
      ]
    }
  }
}
