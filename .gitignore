node_modules/
# Vendored test/demo fixtures that must live under a node_modules dir so capwall's
# attribution treats them as dependencies. These are committed on purpose.
!examples/malicious-dep-demo/node_modules/
!packages/core/test/fixtures/node_modules/
!packages/core/test/fixtures/esm/node_modules/
!packages/core/test/fixtures/launder/node_modules/
!packages/core/test/fixtures/eval-forge/node_modules/
!packages/core/test/fixtures/pkg-identity/node_modules/
!packages/cli/test/fixtures/app/node_modules/
!scripts/bench/fixtures/node_modules/
# NESTED node_modules, which the `node_modules/` rule re-excludes at every level — git cannot
# re-include a path whose parent directory is excluded, so each level needs its own negation.
# These layouts ARE the subject under test for issue #92 (a package installed under another
# package is a distinct principal), so they have to be committed exactly as npm would create
# them, attacker-shaped copies included.
!packages/core/test/fixtures/pkg-identity/node_modules/forge-dep/node_modules/
!packages/core/test/fixtures/pkg-identity/node_modules/forge-dep/node_modules/.pnpm/forge-target@1.0.0/node_modules/
!packages/core/test/fixtures/pkg-identity/node_modules/legit-host/node_modules/
!packages/cli/test/fixtures/app/node_modules/trace-dep/node_modules/
dist/
*.log
.DS_Store
coverage/
.turbo/
*.tsbuildinfo
.env
.env.*
.nexus-agents/

# Per-test scratch directories (created in beforeEach, removed in afterEach; only left
# behind by a crashed run).
packages/core/test/fixtures/scratch*/
