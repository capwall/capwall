{
  "name": "capwall-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Runtime, per-package capability firewall for Node.js — defense-in-depth against supply-chain malware.",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capwall/capwall.git"
  },
  "homepage": "https://github.com/capwall/capwall#readme",
  "bugs": "https://github.com/capwall/capwall/issues",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "preinstall": "node scripts/assert-pnpm-install.mjs",
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "oxlint",
    "lint:commits": "node scripts/check-commit-messages.mjs",
    "check:published": "node scripts/check-release-published.mjs",
    "bench": "node scripts/bench/bench.mjs",
    "bench:gate": "node scripts/bench/bench.mjs --quick",
    "bench:startup": "node scripts/bench/startup.mjs",
    "canary": "node scripts/canary.mjs",
    "mutation:gate": "node scripts/mutation-guard.mjs",
    "mutation:recover": "node scripts/mutation-guard.mjs --recover",
    "mutation:status": "node scripts/mutation-sentinel.mjs --status",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:22": "bash scripts/ci-local.sh 22",
    "ci:local:24": "bash scripts/ci-local.sh 24",
    "ci:local:26": "bash scripts/ci-local.sh 26"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "oxlint": "1.76.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
