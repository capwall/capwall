{
  "name": "capwall-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime, per-package capability firewall for Node.js — defense-in-depth against supply-chain malware.",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamzujkowski/capwall.git"
  },
  "homepage": "https://github.com/williamzujkowski/capwall#readme",
  "bugs": "https://github.com/williamzujkowski/capwall/issues",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "node scripts/assert-pnpm-install.mjs",
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "oxlint",
    "bench": "node scripts/bench/bench.mjs",
    "bench:gate": "node scripts/bench/bench.mjs --quick",
    "mutation:gate": "node scripts/mutation-guard.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:22": "bash scripts/ci-local.sh 22",
    "ci:local:24": "bash scripts/ci-local.sh 24"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "oxlint": "1.76.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
