{
  "name": "capwall-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime, per-package capability firewall for Node.js — defense-in-depth against supply-chain malware.",
  "license": "MIT",
  "author": "William Zujkowski",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "bench": "node scripts/bench/bench.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:22": "bash scripts/ci-local.sh 22"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "@types/node": "^20.14.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}
